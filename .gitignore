# ============================================================
# Ứng dụng Xưởng Nét - .gitignore
# ============================================================

# --- 1. Môi trường & Bí mật (Secrets & Environment Files) ---
.env
.env.local
.env.*.local
*.env
server/.env
server/scripts/backup/.env
service-account*.json
*.pem
*.key
implementation_plan 2.md
implementation_plan 2.md

# Ngoại trừ các file cấu hình mẫu
!.env.example
!server/.env.example
!server/scripts/backup/.env.example

# --- 2. Thư viện & Dependencies ---
node_modules/
*/node_modules/
server/node_modules/
server/scripts/backup/node_modules/

# --- 3. Cơ sở dữ liệu SQLite & File dữ liệu động ---
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.db
*.db-shm
*.db-wal
server/data.sqlite3
server/data.sqlite3-shm
server/data.sqlite3-wal

# --- 4. Sao lưu dữ liệu & Thư mục tạm (Backups & Restores) ---
server/scripts/backup/snapshots/
server/scripts/backup/restored/
snapshots/
restored/
*.zip
*.tar.gz
*.bak

# --- 5. Logs & Nhật ký hệ thống ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/scripts/backup/backup.log

# --- 6. Hệ điều hành & IDE (OS & Editor files) ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
