# ====== Chung ======
# Số ngày giữ lại bản backup, cũ hơn sẽ bị xoá (cả local lẫn remote)
BACKUP_RETENTION_DAYS=14

# ====== Cách 1: rclone (khuyến nghị — xem README.md để cài đặt) ======
# Tên remote đã cấu hình trong `rclone config` (ví dụ trỏ tới Google Drive)
BACKUP_RCLONE_REMOTE=gdrive
# Thư mục trên remote sẽ chứa các file backup
BACKUP_RCLONE_PATH=xuong-net-backups

# ====== Cách 2: Node + Google Drive API (chỉ cần nếu KHÔNG dùng rclone) ======
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
GOOGLE_DRIVE_FOLDER_ID=
