PORT=3000
NODE_ENV=development

# URL trang chủ (dùng để callback)
BASE_URL=http://localhost:3000

# Khóa JWT (tự sinh ngẫu nhiên)
JWT_SECRET=super-secret-key-change-me

# Replicate API (bắt buộc)
REPLICATE_API_TOKEN=r8_...
# Model dùng cho nút "Phóng to Ảnh" (Real-ESRGAN)
REPLICATE_MODEL=nightmareai/real-esrgan
# Lưu ý: Model GFPGAN (Phục chế khuôn mặt) dùng pinned version ID hardcode
# trong server/src/routes/upscale.js — KHÔNG cần thêm biến env nào.
# Chỉ cần REPLICATE_API_TOKEN là đủ để dùng cả 2 model.

# Mức phí & quà tặng
VND_PER_CREDIT=1000
CREDITS_PER_UPSCALE=5
MIN_DEPOSIT_VND=10000
SIGNUP_BONUS_CREDITS=10

# Admin Emails (cách nhau dấu phẩy)
ADMIN_EMAILS=admin@xuongnet.com

# Webhook Cổng Thanh Toán (Tuỳ chọn 1 trong 2)
SEPAY_API_KEY=
PAY2S_API_KEY=

# Cấu hình Google Auth (Tạo tại Google Cloud Console)
GOOGLE_CLIENT_ID=
