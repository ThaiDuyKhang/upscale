# ====== Server ======
PORT=8787
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-va-bi-mat
# Email trong danh sách này sẽ tự động thành admin khi đăng ký tài khoản
ADMIN_EMAILS=admin@vidu.com

# ====== Replicate (chức năng nâng cấp ảnh bằng AI) ======
REPLICATE_API_TOKEN=
# nightmareai/real-esrgan là Official model trên Replicate -> chỉ cần owner/name, không cần version
REPLICATE_MODEL=nightmareai/real-esrgan

# ====== Thông tin tài khoản ngân hàng nhận tiền (dùng để tạo mã VietQR) ======
# Tra cứu mã BIN ngân hàng tại https://www.vietqr.io/danh-sach-ngan-hang-hien-thi-logo/
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=CONG TY CUA BAN

# ====== SePay (khuyến nghị dùng trước — đã kiểm chứng payload) ======
# Vào SePay Dashboard > Tích hợp > Webhooks > Bảo mật > chọn "API Key",
# rồi đặt cùng giá trị này cả 2 nơi.
SEPAY_WEBHOOK_APIKEY=doi-chuoi-nay-thanh-api-key-bi-mat

# ====== Pay2S (tuỳ chọn — xem ghi chú trong src/payments/pay2s.js trước khi bật) ======
PAY2S_PARTNER_CODE=
PAY2S_ACCESS_KEY=
PAY2S_SECRET_KEY=

# ====== Quy đổi & giá mặc định (admin có thể đổi lại trong Dashboard sau khi chạy) ======
VND_PER_CREDIT=1000
CREDITS_PER_UPSCALE=5
MIN_DEPOSIT_VND=10000
SIGNUP_BONUS_CREDITS=0
